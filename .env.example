# MangaRead environment. Copy to .env for `cargo run`, or set these in
# compose.yaml. Branding and email are better set in /admin (no restart).

# ── Core ────────────────────────────────────────────────────
MANGAREAD_DB=mangaread.db
# Public URL, used in emailed links and OAuth callbacks.
MANGAREAD_BASE_URL=http://localhost:3000
# 1 when served over HTTPS: marks the session cookie Secure.
# MANGAREAD_COOKIE_SECURE=1
# 1 only behind a reverse proxy that sets X-Forwarded-For (rate limits key on it).
# MANGAREAD_TRUST_PROXY=1
RUST_LOG=info

# ── Email (boot defaults; /admin/email overrides) ───────────
# SMTP_URL=smtps://user:password@smtp.example.com
# SMTP_FROM=MangaRead <noreply@example.com>

# ── Branding boot defaults (/admin/branding overrides) ──────
# SITE_TITLE=MangaRead
# SITE_COLOR=#f59e0b
# SITE_BG=#131210

# ── OAuth (optional; a provider appears once both are set) ──
# MANGAREAD_OAUTH_GOOGLE_ID=
# MANGAREAD_OAUTH_GOOGLE_SECRET=
# MANGAREAD_OAUTH_GITHUB_ID=
# MANGAREAD_OAUTH_GITHUB_SECRET=
# MANGAREAD_OAUTH_DISCORD_ID=
# MANGAREAD_OAUTH_DISCORD_SECRET=

# ── Scraping ────────────────────────────────────────────────
# Docker needs --no-sandbox.
CHROMIUM_FLAGS=--no-sandbox --disable-dev-shm-usage --disable-gpu --headless
# CHROMEDRIVER_PATH=/usr/bin/chromedriver
# MANGAREAD_STATIC_DIR=/app/static
