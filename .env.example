# ── MangaRead configuration ──────────────────────────────────
# Copy this file to .env and adjust values.
# ⚠  Only variables marked [Rust] are read by the application.
#    CSS-only variables are hints — override them via a local
#    stylesheet or inline <style> (see style.css :root).

# ── Application [Rust] ──────────────────────────────────────

# Site name shown in the browser tab, header logo, and footer.
SITE_TITLE=MangaRead

# Primary accent color (hex). Accent hover/dim/glow are derived.
SITE_COLOR=#3b82f6

# Page background color.
SITE_BG=#0f0f0f

# ── Application Runtime ─────────────────────────────────────

# Path to the SQLite database file.
MANGAREAD_DB=/app/data/mangaread.db

# Extra flags passed to Chromium for scraping (Docker needs --no-sandbox).
CHROMIUM_FLAGS=--no-sandbox --disable-dev-shm-usage --disable-gpu

# Log level (trace / debug / info / warn / error).
RUST_LOG=info

# Override the static file directory (default: compiled-in path).
# MANGAREAD_STATIC_DIR=/app/static

# ── CSS Customization (override in style.css or inline) ─────
#
# --max-width: 1200px
# --container-padding: 1.5rem
# --font-display: 'Space Grotesk', sans-serif
# --font-body: 'Inter', sans-serif
#
# Example override in a local <style> tag:
#   :root { --max-width: 1400px; --font-body: 'Georgia', serif; }
